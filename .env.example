# Application
APP_NAME=TaskFlow
ENVIRONMENT=development
DEBUG=false

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace_with_a_local_development_password
DATABASE_URL=postgresql+psycopg://taskflow:replace_with_a_local_development_password@localhost:5432/taskflow

# Authentication
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]